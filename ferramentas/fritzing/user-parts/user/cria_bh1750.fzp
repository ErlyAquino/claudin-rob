<?xml version="1.0" encoding="UTF-8"?>
<module moduleId="cria_bh1750" fritzingVersion="0.9.4">
 <version>1</version>
 <author>Espaço Cria (gerar_pecas_luz.py)</author>
 <title>BH1750 (GY-302) sensor de luminosidade I2C</title>
 <label>LUX</label>
 <date>2026-11-03</date>
 <tags><tag>cria</tag><tag>agua</tag><tag>luz</tag></tags>
 <properties><property name="family">cria_bh1750</property><property name="variant">variant 1</property></properties>
 <description>Módulo GY-302 com o sensor de luz ambiente BH1750FVI: iluminância em lux, 16 bits, interface I2C. Endereço 0x23 com ADDR solto ou no GND; 0x5C com ADDR no 3,3 V. Alimentação pelo 3,3 V do ESP32.</description>
 <views>
  <iconView><layers image="icon/cria_bh1750_icon.svg"><layer layerId="icon"/></layers></iconView>
  <breadboardView><layers image="breadboard/cria_bh1750_breadboard.svg"><layer layerId="breadboard"/></layers></breadboardView>
  <schematicView><layers image="schematic/cria_bh1750_schematic.svg"><layer layerId="schematic"/></layers></schematicView>
  <pcbView><layers image="pcb/cria_bh1750_pcb.svg"><layer layerId="silkscreen"/><layer layerId="copper0"/><layer layerId="copper1"/></layers></pcbView>
 </views>
 <connectors>
  <connector id="connector0" type="male" name="VCC">
   <description>alimentação: 3,3 V do ESP32</description>
   <views>
    <breadboardView><p layer="breadboard" svgId="connector0pin"/></breadboardView>
    <schematicView><p layer="schematic" svgId="connector0pin" terminalId="connector0terminal"/></schematicView>
    <pcbView><p layer="copper0" svgId="connector0pin"/><p layer="copper1" svgId="connector0pin"/></pcbView>
   </views>
  </connector>
  <connector id="connector1" type="male" name="GND">
   <description>terra</description>
   <views>
    <breadboardView><p layer="breadboard" svgId="connector1pin"/></breadboardView>
    <schematicView><p layer="schematic" svgId="connector1pin" terminalId="connector1terminal"/></schematicView>
    <pcbView><p layer="copper0" svgId="connector1pin"/><p layer="copper1" svgId="connector1pin"/></pcbView>
   </views>
  </connector>
  <connector id="connector2" type="male" name="SCL">
   <description>I2C clock (GPIO 22 no ESP32)</description>
   <views>
    <breadboardView><p layer="breadboard" svgId="connector2pin"/></breadboardView>
    <schematicView><p layer="schematic" svgId="connector2pin" terminalId="connector2terminal"/></schematicView>
    <pcbView><p layer="copper0" svgId="connector2pin"/><p layer="copper1" svgId="connector2pin"/></pcbView>
   </views>
  </connector>
  <connector id="connector3" type="male" name="SDA">
   <description>I2C dados (GPIO 21 no ESP32)</description>
   <views>
    <breadboardView><p layer="breadboard" svgId="connector3pin"/></breadboardView>
    <schematicView><p layer="schematic" svgId="connector3pin" terminalId="connector3terminal"/></schematicView>
    <pcbView><p layer="copper0" svgId="connector3pin"/><p layer="copper1" svgId="connector3pin"/></pcbView>
   </views>
  </connector>
  <connector id="connector4" type="male" name="ADDR">
   <description>endereço: solto ou GND 0x23, 3,3 V 0x5C</description>
   <views>
    <breadboardView><p layer="breadboard" svgId="connector4pin"/></breadboardView>
    <schematicView><p layer="schematic" svgId="connector4pin" terminalId="connector4terminal"/></schematicView>
    <pcbView><p layer="copper0" svgId="connector4pin"/><p layer="copper1" svgId="connector4pin"/></pcbView>
   </views>
  </connector>
 </connectors>
</module>
